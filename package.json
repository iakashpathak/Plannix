{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow - full stack task management system (React + Express + MongoDB, deployable on Vercel)",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/dev.js",
    "dev:client": "npm --prefix client run dev",
    "start": "node server/dev.js",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/integration",
    "test:client": "npm --prefix client test",
    "test:all": "npm test && npm run test:client",
    "seed": "node server/scripts/seed.js",
    "make-admin": "node server/scripts/makeAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
