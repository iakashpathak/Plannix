# Copy this file to ".env" (never commit .env). All values below are PLACEHOLDERS.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Replace placeholders; include /taskflow.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/taskflow?retryWrites=true&w=majority

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# development | production | test
NODE_ENV=development

# Local API port (only used by `npm run dev:server`)
PORT=5000

# Optional: only needed if the frontend is hosted on a DIFFERENT origin than the API.
# Comma-separated list. Leave empty for same-origin (Vite proxy locally, Vercel rewrites in production).
CLIENT_URL=

# Optional: bcrypt cost factor (default 10)
BCRYPT_ROUNDS=10

# Optional: separate database used by integration tests (it gets WIPED - never point at real data)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/taskflow_test
